+KeybindingManager::KeybindingManager(SettingsManager& settings):settings_(settings),defaults_(defaults()),bindings_(defaults_){}
+bool KeybindingManager::hasCommand(const std::string& command)const{return defaults_.count(command)>0;}
+void KeybindingManager::registerCommand(const std::string& command,const std::string& key){
+    if(command.empty()||command.size()>128||hasCommand(command))return;
+    const auto normalized=normalizeShortcut(key);
+    defaults_[command]=normalized;bindings_[command]=normalized;
+}
+void KeybindingManager::load(){
+    bindings_=defaults_;dormantOverrides_.clear();diagnostics_.clear();malformed_=false;
+    const auto file=settings_.directory()/"keybindings.json";
+    std::error_code ec;if(!std::filesystem::exists(file,ec))return;
+    std::ifstream in(file,std::ios::binary);if(!in){malformed_=true;diagnostics_.push_back("Cannot read keybindings.json");return;}
+    std::string source{std::istreambuf_iterator<char>(in),std::istreambuf_iterator<char>()};
+    Json j;std::string error;if(source.size()>1024*1024||!Json::parse(source,j,&error)||!j.isArray()){
+        malformed_=true;diagnostics_.push_back("Invalid keybindings.json: "+error);return;
+    }
+    auto candidate=bindings_;
+    for(const auto& entry:j.asArray()){
+        const auto command=entry["command"].string(),key=entry["key"].string();
+        if(!entry.isObject()||!entry["command"].isString()||!entry["key"].isString()){
+            diagnostics_.push_back("Ignoring malformed keybinding entry");continue;
+        }
+        const auto normalized=key.empty()?"":normalizeShortcut(key);
+        if(!key.empty()&&normalized.empty()){
+            diagnostics_.push_back("Invalid shortcut for "+command+": "+key);continue;
+        }
+        if(!hasCommand(command)){
+            // Preserve disabled plugin keybindings without registering their actions.
+            if(SettingsManager::validPluginId(command))dormantOverrides_[command]=normalized;
+            diagnostics_.push_back("Inactive/unknown shortcut command: "+command);continue;
+        }
+        candidate[command]=normalized;
+    }
+    std::map<std::string,std::string> assigned;
+    bool collision=false;
+    for(const auto& kv:candidate){
+        if(kv.second.empty())continue;
+        const auto other=assigned.find(kv.second);
+        if(other!=assigned.end()){
+            collision=true;diagnostics_.push_back("Conflict: "+kv.second+" for "+other->second+" and "+kv.first);
+        }else assigned[kv.second]=kv.first;
+    }
+    if(collision){
+        // Fail open: a conflicting configuration cannot hide built-in shortcuts.
+        diagnostics_.push_back("Conflicting overrides ignored; using safe defaults");
+        bindings_=defaults_;
+    }else bindings_=std::move(candidate);
+}
+bool KeybindingManager::set(const std::string& command,const std::string& key,std::string* error){
+    if(!hasCommand(command)){if(error)*error="Unknown command";return false;}
+    const auto normalized=key.empty()?"":normalizeShortcut(key);
+    if(!key.empty()&&normalized.empty()){if(error)*error="Use one valid shortcut, e.g. Ctrl+G, Ctrl+Shift+P or F3";return false;}
+    if(!normalized.empty())for(const auto& pair:bindings_)
+        if(pair.first!=command&&pair.second==normalized){if(error)*error="Shortcut already assigned to "+pair.first;return false;}
+    bindings_[command]=normalized;
+    if(error)error->clear();
+    return true;
+}
+void KeybindingManager::reset(const std::string& command){if(hasCommand(command))bindings_[command]=defaults_.at(command);}
+void KeybindingManager::resetAll(){bindings_=defaults_;}
+std::string KeybindingManager::get(const std::string& command)const{const auto it=bindings_.find(command);return it==bindings_.end()?"":it->second;}
+std::vector<Binding> KeybindingManager::all()const{
+    std::vector<Binding> out;
+    for(const auto& kv:bindings_){const auto it=defaults_.find(kv.first);out.push_back({kv.first,kv.second,it==defaults_.end()||it->second!=kv.second});}
+    return out;
+}
+bool KeybindingManager::save(std::string* error)const{
+    if(malformed_){if(error)*error="Refusing to overwrite invalid keybindings.json; repair or rename the file";return false;}
+    Json::Array changes;
+    for(const auto& kv:dormantOverrides_){
+        Json obj=Json::object();obj["key"]=kv.second;obj["command"]=kv.first;changes.emplace_back(std::move(obj));
+    }
+    for(const auto& kv:bindings_)if(kv.second!=defaults_.at(kv.first)){
+        Json obj=Json::object();obj["key"]=kv.second;obj["command"]=kv.first;changes.emplace_back(std::move(obj));
+    }
+    return SettingsManager::writeAtomic(settings_.directory()/"keybindings.json",Json(std::move(changes)).dump(2)+"\n",error);
+}
