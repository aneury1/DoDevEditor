+                                  DodevPromptFn callback,void* user_data){
+    auto* p=instance(ctx);if(!callback||!p->owner->hooks_.promptInput)return 0;
+    const DodevHostAPI* host=&p->host;
+    return p->owner->hooks_.promptInput(title?title:"Plugin input",label?label:"Enter value",
+       initial?initial:"",[host,callback,user_data](const std::string& value){
+           callback(host,value.c_str(),user_data);
+       })?1:0;
+}
