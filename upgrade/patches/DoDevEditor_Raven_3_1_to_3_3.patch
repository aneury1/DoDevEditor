+void EditorApp::refreshQuickOpen(){
+    if(quickOpenWindow_==R_INVALID_ID)return;
+    const auto query=lower(trim(textInput(quickOpenWindow_,"quick_query")));
+    const auto list=widget(quickOpenWindow_,"quick_list");
+    Rlist_view_clear_items(list);quickMatches_.clear();
+    if(commandPalette_){
+        std::size_t count=0;
+        for(const auto& command:quickCommands_){
+            if(lower(command).find(query)==std::string::npos)continue;
+            std::string display=command;const auto key=keybindings_.get(command);
+            if(!key.empty())display+="    "+key;
+            Rlist_view_add_item(list,display.c_str());++count;
+            if(count>=250)break;
+        }
+        setLabel(quickOpenWindow_,"quick_status",std::to_string(count)+" commands");
+    }else{
+        for(const auto& path:quickCandidates_){
+            const auto file=lower(path.filename().string());
+            const auto full=lower(path.string());
+            if(!query.empty()&&file.find(query)==std::string::npos&&full.find(query)==std::string::npos)continue;
+            std::error_code ec;const auto relative=folder_.empty()?path:fs::relative(path,folder_,ec);
+            Rlist_view_add_item(list,(ec?path.string():relative.string()).c_str());
+            quickMatches_.push_back(path);if(quickMatches_.size()>=250)break;
+        }
+        setLabel(quickOpenWindow_,"quick_status",std::to_string(quickMatches_.size())+" files (max 250 shown)");
+    }
+    if(Rlist_view_get_item_count(list)>0)Rlist_view_set_selected(list,0);
+}
+void EditorApp::chooseQuickOpen(){
+    if(quickOpenWindow_==R_INVALID_ID)return;
+    const auto list=widget(quickOpenWindow_,"quick_list");
+    const int idx=Rlist_view_get_selected(list);
+    if(idx<0)return;
+    std::string action;
+    fs::path path;
+    if(commandPalette_){
+        const char* row=Rlist_view_get_item_text(list,idx);
+        if(!row)return;
+        action=std::string(row);auto space=action.find(' ');if(space!=std::string::npos)action.resize(space);
+    }else{
+        if(idx>=static_cast<int>(quickMatches_.size()))return;
+        path=quickMatches_[static_cast<size_t>(idx)];
+    }
+    if(Rwindow_is_valid(quickOpenWindow_))Rwindow_destroy(quickOpenWindow_);
+    quickOpenWindow_=R_INVALID_ID;
+    if(!action.empty())handleAction(action);
+    else if(!path.empty())opened(path);
+}
+void EditorApp::keybindingFilterCb(Rid,const char*,void* user){static_cast<EditorApp*>(user)->refreshKeybindingRows();}
