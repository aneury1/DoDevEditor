 void themeDesigner(){auto current=*themes.find(themeName);current.originalXml.clear();wxDialog d(this,wxID_ANY,"Theme designer",wxDefaultPosition,wxSize(570,650),wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER);auto s=new wxBoxSizer(wxVERTICAL);d.SetSizer(s);auto grid=new wxFlexGridSizer(2,8,8);grid->AddGrowableCol(1);s->Add(grid,1,wxEXPAND|wxALL,12);std::vector<std::pair<std::string*,wxTextCtrl*>> fields;auto add=[&](const char* label,std::string& v){grid->Add(new wxStaticText(&d,wxID_ANY,label),0,wxALIGN_CENTER_VERTICAL);auto c=new wxTextCtrl(&d,wxID_ANY,W(v));grid->Add(c,1,wxEXPAND);fields.push_back({&v,c});};current.name+=" Custom";add("Name",current.name);add("Base (Dark/Light)",current.base);add("Accent",current.accent);add("Window",current.window);add("Panel",current.panel);add("Control",current.control);add("Input",current.input);add("Text",current.text);add("Separator",current.separator);add("Keyword",current.keyword);add("String",current.stringColor);add("Comment",current.comment);auto preview=new wxStyledTextCtrl(&d,wxID_ANY,wxDefaultPosition,wxSize(-1,90));preview->SetLexer(wxSTC_LEX_CPP);preview->SetKeyWords(0,"int return");preview->SetText("// Theme preview\nint main() { return 0; }");s->Add(preview,0,wxEXPAND|wxALL,8);auto update=[&]{for(auto& f:fields)*f.first=S(f.second->GetValue());std::string err;if(!current.valid(&err)){wxMessageBox(W(err),"Theme");return false;}wxui::Theme::from(current).editor(preview);return true;};button(&d,s,"Preview",[&]{update();});s->Add(d.CreateStdDialogButtonSizer(wxOK|wxCANCEL),0,wxEXPAND|wxALL,8);palette.apply(&d);update();while(showModal(d)==wxID_OK){if(!update())continue;if(themes.find(current.name)){wxMessageBox("Choose a new theme name.");continue;}auto dir=settings.getString("appearance.customThemesDirectory");auto folder=dir.empty()?settings.directory()/"themes":fs::u8path(dir);wxFileDialog f(&d,"Save custom theme",P(folder),"custom.json","JSON|*.json|XML|*.xml",wxFD_SAVE|wxFD_OVERWRITE_PROMPT);std::error_code ec;fs::create_directories(folder,ec);if(showModal(f)!=wxID_OK)break;std::string err;if(!themes.exportFile(current,F(f.GetPath()),&err)){wxMessageBox(W(err));continue;}themes.add(current);selectTheme(current.name);deferMenus();break;}}
 void shortcutDialog(){wxDialog d(this,wxID_ANY,"Keyboard Shortcuts",wxDefaultPosition,wxSize(720,520),wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER);auto s=new wxBoxSizer(wxVERTICAL);d.SetSizer(s);auto filter=new wxTextCtrl(&d,wxID_ANY);s->Add(filter,0,wxEXPAND|wxALL,5);auto l=list(&d,{"Command","Shortcut"});s->Add(l,1,wxEXPAND|wxALL,5);auto val=new wxTextCtrl(&d,wxID_ANY);s->Add(val,0,wxEXPAND|wxALL,5);bool record=false;val->Bind(wxEVT_KEY_DOWN,[&](wxKeyEvent& e){if(!record){e.Skip();return;}auto key=shortcutFromEvent(e);if(!key.empty()){val->SetValue(W(key));record=false;}});std::string selectedKey;auto refresh=[&]{l->DeleteAllItems();for(auto& b:keybindings.all()){if(!W(b.command).Lower().Contains(filter->GetValue().Lower()))continue;auto i=l->InsertItem(l->GetItemCount(),W(b.command));l->SetItem(i,1,W(b.key));}};filter->Bind(wxEVT_TEXT,[&](wxCommandEvent&){refresh();});l->Bind(wxEVT_LIST_ITEM_SELECTED,[&](wxListEvent& e){selectedKey=S(e.GetText());val->SetValue(W(keybindings.get(selectedKey)));});auto row=new wxBoxSizer(wxHORIZONTAL);s->Add(row,0,wxEXPAND);auto commit=[&]{std::string err;if(!keybindings.save(&err))throw std::runtime_error(err);refresh();};button(&d,row,"Record keys",[&]{record=true;val->SetFocus();});button(&d,row,"Apply",[&]{if(selectedKey.empty())return;std::string err;if(!keybindings.set(selectedKey,S(val->GetValue()),&err))throw std::runtime_error(err);commit();});button(&d,row,"Unbind",[&]{if(!selectedKey.empty()){keybindings.set(selectedKey,"");commit();}});button(&d,row,"Reset selected",[&]{if(!selectedKey.empty()){keybindings.reset(selectedKey);commit();}});button(&d,row,"Reset all",[&]{keybindings.resetAll();commit();});s->Add(d.CreateStdDialogButtonSizer(wxCLOSE),0,wxEXPAND|wxALL,5);d.Bind(wxEVT_BUTTON,[&](wxCommandEvent&){d.EndModal(wxID_CLOSE);},wxID_CLOSE);refresh();palette.apply(&d);showModal(d);deferMenus();}
 void settingsDialog(){wxDialog d(this,wxID_ANY,"Settings",wxDefaultPosition,wxSize(770,620),wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER);auto outer=new wxBoxSizer(wxVERTICAL);d.SetSizer(outer);auto tabs=new wxNotebook(&d,wxID_ANY);outer->Add(tabs,1,wxEXPAND|wxALL,8);std::vector<std::function<void()>> store;std::vector<std::function<void()>> reset;auto pane=[&](const char* title){auto p=new wxScrolledWindow(tabs,wxID_ANY);p->SetScrollRate(0,12);p->SetSizer(new wxBoxSizer(wxVERTICAL));tabs->AddPage(p,title);return p;};auto field=[&](wxWindow* p,const char* label,const std::string& k,bool browse=false){auto r=new wxBoxSizer(wxHORIZONTAL);p->GetSizer()->Add(r,0,wxEXPAND|wxALL,6);r->Add(new wxStaticText(p,wxID_ANY,label),0,wxALIGN_CENTER_VERTICAL|wxRIGHT,8);auto c=new wxTextCtrl(p,wxID_ANY,W(settings.getString(k)));r->Add(c,1,wxEXPAND);if(browse)button(p,r,"Browse...",[&,c]{wxDirDialog f(&d,"Choose folder",c->GetValue());if(showModal(f)==wxID_OK)c->SetValue(f.GetPath());});store.push_back([this,k,c]{settings.set(k,S(c->GetValue()));});reset.push_back([k,c]{auto b=SettingsManager::defaultSettings();auto n=k.find('.');c->SetValue(W(b[k.substr(0,n)][k.substr(n+1)].string()));});};auto check=[&](wxWindow* p,const char* label,const std::string& k){auto c=new wxCheckBox(p,wxID_ANY,label);p->GetSizer()->Add(c,0,wxALL,7);c->SetValue(settings.getBool(k));store.push_back([this,k,c]{settings.set(k,c->GetValue());});reset.push_back([k,c]{auto b=SettingsManager::defaultSettings();auto n=k.find('.');c->SetValue(b[k.substr(0,n)][k.substr(n+1)].boolean());});};auto number=[&](wxWindow* p,const char* label,const std::string& k,int lo,int hi){auto r=new wxBoxSizer(wxHORIZONTAL);p->GetSizer()->Add(r,0,wxALL|wxEXPAND,6);r->Add(new wxStaticText(p,wxID_ANY,label),1,wxALIGN_CENTER_VERTICAL);auto c=new wxSpinCtrl(p,wxID_ANY);c->SetRange(lo,hi);c->SetValue(settings.getInt(k));r->Add(c,0);store.push_back([this,k,c]{settings.set(k,c->GetValue());});reset.push_back([k,c]{auto b=SettingsManager::default