 p=pane("Editor");field(p,"Font family","editor.fontFamily");number(p,"Font size","editor.fontSize",8,64);number(p,"Tab width","editor.tabSize",1,16);check(p,"Word wrap","editor.wordWrap");check(p,"Show line numbers","editor.lineNumbers");check(p,"Insert spaces","editor.insertSpaces");
 p=pane("Appearance");auto choice=new wxChoice(p,wxID_ANY);for(auto& n:themes.names())choice->Append(W(n));choice->SetStringSelection(W(themeName));p->GetSizer()->Add(choice,0,wxEXPAND|wxALL,6);store.push_back([this,choice]{settings.set("appearance.theme",S(choice->GetStringSelection()));});reset.push_back([choice]{choice->SetStringSelection("VS Code Dark Modern");});number(p,"UI font size","appearance.uiFontSize",9,36);field(p,"Custom theme directory","appearance.customThemesDirectory",true);auto format=new wxChoice(p,wxID_ANY);format->Append("json");format->Append("xml");format->SetStringSelection(W(settings.getString("appearance.preferredThemeFormat","json")));p->GetSizer()->Add(format,0,wxALL,6);store.push_back([this,format]{settings.set("appearance.preferredThemeFormat",S(format->GetStringSelection()));});button(p,p->GetSizer(),"Theme designer",[&,choice]{themeDesigner();choice->Clear();for(auto& n:themes.names())choice->Append(W(n));choice->SetStringSelection(W(themeName));});button(p,p->GetSizer(),"Import theme",[&,choice]{themeImport();choice->Clear();for(auto& n:themes.names())choice->Append(W(n));choice->SetStringSelection(W(themeName));});button(p,p->GetSizer(),"Export current theme",[this]{themeExport();});
 p=pane("Terminal");field(p,"Shell executable/profile (restart terminal to apply)","terminal.defaultShell");field(p,"Font family","terminal.fontFamily");number(p,"Font size","terminal.fontSize",8,48);number(p,"Scrollback lines","terminal.scrollbackLines",100,200000);
 p=pane("Templates");field(p,"Custom template directory","templates.directory",true);button(p,p->GetSizer(),"New from template",[this]{newTemplate();});
 p=pane("Keyboard Shortcuts");button(p,p->GetSizer(),"Manage keyboard shortcuts",[this]{shortcutDialog();});
 p=pane("Plugins");check(p,"Enable native plugins (restart required)","plugins.enabled");check(p,"Safe mode (restart required)","plugins.safeMode");field(p,"Plugin directory (restart required)","plugins.directory",true);auto records=new wxCheckListBox(p,wxID_ANY);p->GetSizer()->Add(records,1,wxEXPAND|wxALL,6);for(auto& rec:plugins.records()){auto i=records->Append(W(rec.manifest.name+" — "+rec.status));records->Check(i,plugins.isEnabled(rec.manifest.id));}store.push_back([this,records]{for(size_t i=0;i<plugins.records().size();++i)plugins.setEnabled(plugins.records()[i].manifest.id,records->IsChecked(i));});auto specs=new wxChoice(p,wxID_ANY);auto value=new wxTextCtrl(p,wxID_ANY);p->GetSizer()->Add(specs,0,wxEXPAND|wxALL,5);p->GetSizer()->Add(value,0,wxEXPAND|wxALL,5);for(auto& sp:plugins.settingSpecs())specs->Append(W(sp.owner+" / "+sp.key));specs->Bind(wxEVT_CHOICE,[&,specs,value](wxCommandEvent&){auto& sp=plugins.settingSpecs().at(specs->GetSelection());value->SetValue(W(plugins.pluginSetting(sp.owner,sp.key)));value->SetToolTip(W(sp.description));});button(p,p->GetSizer(),"Save plugin setting",[&,specs,value]{int i=specs->GetSelection();if(i==wxNOT_FOUND)return;auto& sp=plugins.settingSpecs().at(i);if(!plugins.updatePluginSetting(sp.owner,sp.key,S(value->GetValue())))throw std::runtime_error("Unable to save plugin setting");schedule();});button(p,p->GetSizer(),"AI provider profiles",[this]{aiProfiles();});p->GetSizer()->Add(new wxStaticText(p,wxID_ANY,"Plugin enablement/discovery changes apply on restart."),0,wxALL,6);
