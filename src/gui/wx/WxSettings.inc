 void applyEditorSettings(wxStyledTextCtrl* e){int tab=std::clamp(settings.getInt("editor.tabSize",4),1,16);e->SetTabWidth(tab);e->SetIndent(tab);e->SetUseTabs(!settings.getBool("editor.insertSpaces",true));e->SetWrapMode(settings.getBool("editor.wordWrap")?wxSTC_WRAP_WORD:wxSTC_WRAP_NONE);e->SetMarginWidth(0,settings.getBool("editor.lineNumbers",true)?48:0);auto font=wxFont(wxFontInfo(std::clamp(settings.getInt("editor.fontSize",14),8,64)).Family(wxFONTFAMILY_TELETYPE));auto family=settings.getString("editor.fontFamily");if(!family.empty()&&family!="monospace")font.SetFaceName(W(family));for(int i=0;i<256;++i)e->StyleSetFont(i,font);palette.editor(e);}
 void selectTheme(const std::string& name,bool persist=true){auto t=themes.find(name);if(!t)throw std::runtime_error("Unknown theme: "+name);themeName=name;palette=wxui::Theme::from(*t);palette.native();palette.apply(this);for(auto* w:wxTopLevelWindows)if(w!=this&&dynamic_cast<wxDialog*>(w))palette.apply(w);applyUIFont(this);for(auto& d:docs)applyEditorSettings(d.first);palette.docking(aui);for(auto* t:allTerminals()){t->out->setTheme(palette.background,palette.text,palette.selection,settings.getInt("terminal.fontSize",14),W(settings.getString("terminal.fontFamily")));t->screen.setScrollbackLimit(settings.getInt("terminal.scrollbackLines",3000));}aui.Update();refreshThemePicker();wxFrame::Refresh();if(persist){settings.set("appearance.theme",name);saveSettings();}}
 void themeImport(){wxFileDialog d(this,"Import theme",P(settings.directory()),"","Theme files|*.json;*.xml",wxFD_OPEN|wxFD_FILE_MUST_EXIST);if(showModal(d)!=wxID_OK)return;ThemeManager temp;std::string err;if(!temp.importFile(F(d.GetPath()),&err))throw std::runtime_error(err);auto name=temp.names().front();auto value=*temp.find(name);auto path=settings.getString("appearance.customThemesDirectory");auto folder=path.empty()?settings.directory()/"themes":fs::u8path(path);auto stem=F(d.GetFilename()).stem();auto dest=folder/(stem.string()+".json");if(!themes.exportFile(value,dest,&err))throw std::runtime_error(err);themes.add(value);selectTheme(name);deferMenus();}
