index 0000000..9a9360f
--- /dev/null
+++ b/src/EditorAI.cpp
@@ -0,0 +1,134 @@
+#include "EditorApp.h"
+#include <algorithm>
+#include <iostream>
+namespace dodev {
+namespace {
+void button(Rid bar,const char* title,const char* action){
+    auto w=Rbutton_create(title);Rwidget_set_class(w,"chip");Rwidget_set_action(w,action);Rwidget_add_child(bar,w);
+}
+void input(Rid bar,Rid& target,const char* placeholder,const std::string& initial){
+    target=Rwidget_create(R_WIDGET_TEXT_INPUT);
+    Rtext_input_set_placeholder(target,placeholder);
+    Rtext_input_set_text(target,initial.c_str());
+    Rwidget_add_child(bar,target);Rslot_set_fill(target,1);
+}
+std::string value(Rid id){if(id==R_INVALID_ID)return {};const char* str=Rtext_input_get_text(id);return str?str:"";}
+std::string conf(const PluginManager& plugins,const char* key,const char* def){
+    auto v=plugins.pluginSetting("com.dodev.aiassistant",key);return v.empty()?def:v;
+}
+}
+bool EditorApp::openAiAssistant(){
+    if(aiPanel_!=R_INVALID_ID&&Rwidget_is_valid(aiPanel_)){
+        Rdock_area_open_panel(dock_,aiPanel_);return true;
+    }
+    aiPanel_=Rwidget_create(R_WIDGET_VBOX);Rwidget_set_class(aiPanel_,"music-surface surface");
+    auto heading=Rwidget_create(R_WIDGET_HBOX);Rwidget_add_child(aiPanel_,heading);
+    Rwidget_add_child(heading,Rlabel_create("AI ASSISTANT · CODE CHAT"));
+    button(heading,"Save Settings","ai.save");button(heading,"Clear","ai.clear");
+    auto endpointRow=Rwidget_create(R_WIDGET_HBOX);Rwidget_add_child(aiPanel_,endpointRow);
+    input(endpointRow,aiEndpoint_,"Endpoint (HTTPS or local Ollama)",conf(pluginManager_,"endpoint","http://127.0.0.1:11434/v1/chat/completions"));
+    auto modelRow=Rwidget_create(R_WIDGET_HBOX);Rwidget_add_child(aiPanel_,modelRow);
+    input(modelRow,aiModel_,"Model (e.g. llama3.2)",conf(pluginManager_,"model","llama3.2"));
+    input(modelRow,aiKeyEnv_,"API key environment variable",conf(pluginManager_,"keyEnvironment","OPENAI_API_KEY"));
+    aiStatus_=Rlabel_create("Ready. Files are never uploaded unless you choose Explain / Review File.");
+    Rwidget_add_child(aiPanel_,aiStatus_);
+    aiChat_=Rtext_editor_create(aiTranscript_.c_str());
+    Rtext_editor_set_read_only(aiChat_,R_TRUE);
+    Rwidget_set_class(aiChat_,"music-editor");
+    Rwidget_add_child(aiPanel_,aiChat_);Rslot_set_fill(aiChat_,1);
+    Rwidget_add_child(aiPanel_,Rlabel_create("Message (not sent until you press Ask)"));
+    aiPrompt_=Rtext_editor_create("");
+    Rwidget_set_class(aiPrompt_,"music-editor");
+    Rwidget_add_child(aiPanel_,aiPrompt_);
+    auto actions=Rwidget_create(R_WIDGET_HBOX);Rwidget_add_child(aiPanel_,actions);
+    button(actions,"Ask","ai.ask");button(actions,"Explain File","ai.explain");
+    button(actions,"Explain Selection","ai.selection");
+    button(actions,"Review File","ai.review");button(actions,"Cancel","ai.cancel");
+    Rdock_area_add_panel(dock_,aiPanel_,"AI Assistant",R_DOCK_RIGHT,R_INVALID_ID,0.32f);
+    Rdock_area_open_panel(dock_,aiPanel_);
+    return true;
+}
+void EditorApp::stopAiWorker(){
+    aiCancel_.store(true);
+    if(aiWorker_.joinable())aiWorker_.join();
+}
+void EditorApp::aiAction(const std::string& action){
+    if(action=="ai.open"){openAiAssistant();return;}
+    if(action=="ai.cancel"){aiCancel_.store(true);setStatus("AI request cancellation requested");return;}
+    if(action=="ai.clear"){
+        if(aiPending_){setStatus("Cancel the AI request before clearing chat");return;}
+        aiHistory_.clear();aiTranscript_.clear();
+        if(aiChat_!=R_INVALID_ID&&Rwidget_is_valid(aiChat_))Rtext_editor_set_text(aiChat_,"");return;
+    }
+    if(action=="ai.save"){
+        ai::Config conf;
+        conf.endpoint=value(aiEndpoint_);conf.model=value(aiModel_);conf.keyEnvironment=value(aiKeyEnv_);
+        std::string why;if(!ai::validEndpoint(conf.endpoint,&why)){setStatus(why);return;}
+        if(conf.model.empty()||conf.keyEnvironment.empty()){setStatus("Model and key environment name cannot be empty");return;}
+        pluginManager_.updatePluginSetting("com.dodev.aiassistant","endpoint",conf.endpoint);
+        pluginManager_.updatePluginSetting("com.dodev.aiassistant","model",conf.model);
+        pluginManager_.updatePluginSetting("com.dodev.aiassistant","keyEnvironment",conf.keyEnvironment);
+        setStatus("AI provider settings saved (API tokens remain in environment only)");return;
+    }
+    if(action!="ai.ask"&&action!="ai.explain"&&action!="ai.review"&&action!="ai.selection")return;
+    if(!openAiAssistant())return;
+    if(aiPending_){setStatus("AI request still running");return;}
+    const char* prompt=Rtext_editor_get_text(aiPrompt_);
+    std::string question=prompt?prompt:"";
+    std::string document;
+    if(action!="ai.ask"){
+        auto* doc=active();
+        if(!doc||doc->kind!=DocumentKind::Text||!Rwidget_is_valid(doc->editor)){
+            setStatus("Open a source document first");return;
+        }
+        const char* txt=action=="ai.selection"?Rtext_editor_get_selected_text(doc->editor):Rtext_editor_get_text(doc->editor);
+        const auto text=txt?std::string(txt):std::string();
+        if(action=="ai.selection"&&text.empty()){
+            setStatus("Select some source text before choosing Explain Selection");return;
+        }
+        document="File: "+doc->title+"\n"+text;
+        question=(action=="ai.review"?"Review this code for bugs, safety and correctness. Suggest concrete improvements.":
+                 action=="ai.selection"?"Explain the selected source code and its behavior.":
+                 "Explain the main functions, control flow and design of this code.")+
+                 (question.empty()?std::string():"\nAdditional question: "+question);
+    }
+    if(question.empty()){setStatus("Type a question before sending it");return;}
+    ai::Config config;
+    config.endpoint=value(aiEndpoint_);config.model=value(aiModel_);config.keyEnvironment=value(aiKeyEnv_);
+    const auto sec=conf(pluginManager_,"timeoutSeconds","45");
+    const auto bytes=conf(pluginManager_,"maxContextBytes","16000");
+    try{config.timeoutSeconds=std::stoi(sec);config.maxContextBytes=static_cast<std::size_t>(std::stoul(bytes));}catch(...){ }
+    std::string why;if(!ai::validEndpoint(config.endpoint,&why)){setStatus(why);return;}
+    if(aiWorker_.joinable())aiWorker_.join();
+    aiCancel_.store(false);aiPending_=true;aiReady_=false;
+    aiTranscript_+="\nYOU: "+question+"\n";
+    if(!document.empty())aiTranscript_+="[Active file explicitly attached: "+std::to_string(document.size())+" bytes]\n";
+    if(aiChat_!=R_INVALID_ID&&Rwidget_is_valid(aiChat_))Rtext_editor_set_text(aiChat_,aiTranscript_.c_str());
+    Rtext_editor_set_text(aiPrompt_,"");
+    Rlabel_set_text(aiStatus_,"Contacting AI provider...");
+    const auto history=aiHistory_;
+    aiWorker_=std::thread([this,config,history,question,document]{
+        auto result=ai::complete(config,history,question,document,&aiCancel_);
+        std::lock_guard<std::mutex> lock(aiMutex_);aiReply_=std::move(result);aiReady_=true;
+    });
+    aiHistory_.push_back({"user",question});
+}
+void EditorApp::refreshAiPanel(){
+    if(!aiPending_)return;
+    ai::Reply reply;
+    {
+        std::lock_guard<std::mutex> lock(aiMutex_);
+        if(!aiReady_)return;
+        reply=aiReply_;aiReady_=false;
+    }
+    if(aiWorker_.joinable())aiWorker_.join();
+    aiPending_=false;
+    const auto line=reply.success?reply.answer:"ERROR: "+reply.error;
+    if(reply.success)aiHistory_.push_back({"assistant",reply.answer});
+    aiTranscript_+="\nASSISTANT: "+line+"\n";
+    if(aiTranscript_.size()>180000)aiTranscript_.erase(0,aiTranscript_.size()-100000);
+    if(aiChat_!=R_INVALID_ID&&Rwidget_is_valid(aiChat_))Rtext_editor_set_text(aiChat_,aiTranscript_.c_str());
+    if(aiStatus_!=R_INVALID_ID&&Rwidget_is_valid(aiStatus_))Rlabel_set_text(aiStatus_,reply.success?"Completed":"Request failed; check provider settings");
+    if(!reply.success)std::clog<<"[DoDevEditor][AI] "<<reply.error<<"\n";
+}
+}
