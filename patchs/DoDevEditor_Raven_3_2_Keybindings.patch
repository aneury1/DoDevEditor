+std::string strip(const std::string& text){
+    auto b=text.find_first_not_of(" \t\r\n");if(b==std::string::npos)return {};
+    auto e=text.find_last_not_of(" \t\r\n");return text.substr(b,e-b+1);
+}
+std::string up(std::string s){for(char& c:s)c=static_cast<char>(std::toupper(static_cast<unsigned char>(c)));return s;}
+std::string keyName(const std::string& candidate){
+    const std::string n=up(strip(candidate));
+    if(n.size()==1&&((n[0]>='A'&&n[0]<='Z')||(n[0]>='0'&&n[0]<='9')))return n;
+    static const std::map<std::string,std::string> alias={
+        {"`","Grave"},{"GRAVE","Grave"},{"BACKTICK","Grave"},{"/","Slash"},
+        {"SLASH","Slash"},{"DELETE","Delete"},{"DEL","Delete"},{"SPACE","Space"},
+        {"UP","Up"},{"DOWN","Down"},{"LEFT","Left"},{"RIGHT","Right"},
+        {"HOME","Home"},{"END","End"},{"TAB","Tab"},{"ENTER","Enter"},
+        {"ESCAPE","Escape"},{"ESC","Escape"},{"BACKSPACE","Backspace"},
+        {"PAGEUP","PageUp"},{"PAGEDOWN","PageDown"},{"INSERT","Insert"},
+        {"MINUS","Minus"},{"-","Minus"},{"EQUAL","Equal"},{"=","Equal"},
+        {"SEMICOLON","Semicolon"},{";","Semicolon"},{"COMMA","Comma"},{",","Comma"},
+        {"PERIOD","Period"},{".","Period"},{"BACKSLASH","Backslash"},
+        {"[","LeftBracket"},{"]","RightBracket"},
+        {"F1","F1"},{"F2","F2"},{"F3","F3"},{"F4","F4"},
+        {"F5","F5"},{"F6","F6"},{"F7","F7"},{"F8","F8"},
+        {"F9","F9"},{"F10","F10"},{"F11","F11"},{"F12","F12"}
+    };
+    const auto it=alias.find(n);return it==alias.end()?"":it->second;
+}
+}
+Shortcut parseShortcut(const std::string& source){
+    Shortcut s;const auto raw=strip(source);if(raw.empty())return s;
+    std::istringstream segments(raw);std::string piece;bool keyFound=false;
+    while(std::getline(segments,piece,'+')){
+        const auto x=up(strip(piece));
+        if(x.empty())return {};
+        unsigned mod=0;
+        if(x=="CTRL"||x=="CONTROL")mod=Ctrl;
+        else if(x=="SHIFT")mod=Shift;
+        else if(x=="ALT"||x=="OPTION")mod=Alt;
+        else if(x=="SUPER"||x=="META"||x=="CMD"||x=="COMMAND")mod=Super;
+        if(mod){if(keyFound||(s.modifiers&mod))return {};s.modifiers|=mod;}
+        else {if(keyFound)return {};s.key=keyName(x);if(s.key.empty())return {};keyFound=true;}
+    }
+    // Block bare printable keys: those would interfere with normal text entry.
+    s.valid=keyFound && (s.modifiers!=0 || s.key.size()>1);
+    return s.valid?s:Shortcut{};
+}
+std::string formatShortcut(const Shortcut& k){if(!k.valid)return {};
+    std::string s;
+    if(k.modifiers&Ctrl)s+="Ctrl+";
+    if(k.modifiers&Shift)s+="Shift+";
+    if(k.modifiers&Alt)s+="Alt+";
+    if(k.modifiers&Super)s+="Super+";
+    return s+k.key;
+}
+std::string normalizeShortcut(const std::string& source){return formatShortcut(parseShortcut(source));}
